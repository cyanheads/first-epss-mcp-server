{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "first-epss-mcp-server",
  "version": "0.1.1",
  "description": "Look up FIRST EPSS exploitation scores and daily history, find CVEs by score threshold, and prioritize CVEs with caller-supplied CVSS via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/first-epss-mcp-server#readme",
  "repository": "https://github.com/cyanheads/first-epss-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "typescript", "bun", "stdio", "streamable-http", "epss", "first", "cve", "cvss", "vulnerability", "vulnerability-management", "exploit-prediction", "security", "ai-agents", "ai-tools", "cyanheads"],
  "mcpServers": {
    "first-epss-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/first-epss-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
